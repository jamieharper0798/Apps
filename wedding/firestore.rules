rules_version = '2';

// Published automatically by .github/workflows/deploy-wedding.yml whenever this file changes on main.
service cloud.firestore {
  match /databases/{database}/documents {
    // The User UIDs (Firebase console → Authentication → Users) of the people who can see the guest list.
    function isCouple() {
      return request.auth != null && request.auth.uid in ['NaERrR3freZ6dtRkePZmXIyuAU33'];
    }

    // The wedding details, uploaded by the deploy workflow. Only signed-in guests can read them.
    match /site/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /weddingRsvps/{rsvpId} {
      // Signed-in guests can send a reply, but only in the shape the RSVP form sends.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['firstName', 'lastName', 'attending', 'partySize', 'guestNames', 'dietary', 'song', 'message', 'createdAt'])
                    && request.resource.data.firstName is string
                    && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 60
                    && request.resource.data.lastName is string
                    && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 60
                    && request.resource.data.attending is bool
                    && request.resource.data.partySize is int
                    && request.resource.data.partySize >= 0 && request.resource.data.partySize <= 6
                    && request.resource.data.guestNames is string && request.resource.data.guestNames.size() <= 600
                    && request.resource.data.dietary is string && request.resource.data.dietary.size() <= 300
                    && request.resource.data.song is string && request.resource.data.song.size() <= 200
                    && request.resource.data.message is string && request.resource.data.message.size() <= 1000
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isCouple();
    }
  }
}
